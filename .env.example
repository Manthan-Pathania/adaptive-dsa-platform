# ==============================================================================
# Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# NOTE: Real .env files are git-ignored and MUST NEVER be committed to Git.
# ==============================================================================

# Application Environment: 'development', 'test', 'production'
APP_ENV=development

# HTTP Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=10s

# PostgreSQL Database Configuration
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=<sslmode>
DATABASE_URL=postgres://dsa_user:dsa_password@localhost:5432/dsa_db?sslmode=disable

# PostgreSQL Connection Pool Limits
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

# Structured Logging Configuration
# Levels: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info
# Formats: 'json' (recommended for production), 'text' (convenient for local dev)
LOG_FORMAT=text

# Session Security Configuration
SESSION_COOKIE_NAME=session_token
SESSION_COOKIE_EXPIRY=336h
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

# Authentication, Rate Limiting & CSRF Security
# CSRF_SECRET MUST be at least 32 characters in length
CSRF_SECRET=super-secret-csrf-key-min-32-bytes!
AUTH_RATE_LIMIT_RPM=15

# Redis Configuration (Optional in Phase 1/2, reserved for future rate-limits & queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gemini AI Tutoring & Credit System
# Leave GEMINI_API_KEY blank to use the deterministic Mock AI Provider for offline testing/development
GEMINI_API_KEY=
# Configured model ID (e.g., gemini-3.8-flash for flagship reasoning, gemini-3.5-flash-lite for free-tier low-latency)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=15s
GEMINI_RPM=15
WELCOME_CREDITS=50

# Razorpay Payment Gateway (Test Mode Only)
# Leave blank to use deterministic MockPaymentProvider for offline testing and CI
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
